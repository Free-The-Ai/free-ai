---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { buildDefaultPageJsonLd } from "../utils/jsonLd";

const jsonLd = buildDefaultPageJsonLd();

const links = [
    { href: "/home", label: "Home", icon: "home" },
    { href: "/docs", label: "API docs", icon: "menu_book" },
    { href: "/models", label: "Models", icon: "view_carousel" },
    { href: "/quickstart", label: "Quickstart", icon: "rocket_launch" },
    { href: "/setup", label: "Setup guides", icon: "settings" },
    { href: "/pricing", label: "Pricing", icon: "payments" },
    { href: "/status", label: "Status", icon: "monitoring" },
    { href: "/support", label: "Support", icon: "support_agent" },
];
---

<Layout
    title="Page not found - FreeTheAi"
    description={siteConfig.description}
    jsonLd={jsonLd}
    currentPath="/404"
>
    <main class="not-found-main">
        <section class="not-found-hero shell">
            <span class="eyebrow">Error 404</span>
            <h1>Page not found.</h1>
            <p class="not-found-lede">
                The page you tried to open doesn't exist. The free OpenAI-compatible
                API and the full site are still right here.
            </p>
            <div class="not-found-search" data-nf-search>
                <div class="search-field">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <label class="sr-only" for="not-found-search">Search the site</label>
                    <input
                        type="search"
                        id="not-found-search"
                        placeholder="Search pages..."
                        aria-label="Search pages"
                        autocomplete="off"
                    />
                </div>
                <div class="nf-search-menu" role="listbox" aria-label="Site pages">
                    {links.map((link) => (
                        <a role="option" href={link.href}>
                            <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
                            <span>{link.label}</span>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <section class="section shell not-found-links">
            <span class="eyebrow">Common destinations</span>
            <div class="not-found-grid">
                {links.map((link) => (
                    <a class="panel not-found-tile" href={link.href}>
                        <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
                        <strong>{link.label}</strong>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>

<script>
    (function poll(attempts) {
        if (typeof window.__soundPlay === "function") {
            window.__soundPlay("notification.error");
        } else if (attempts > 0) {
            setTimeout(function () { poll(attempts - 1); }, 100);
        }
    })(50);

    (function () {
        var input = document.getElementById("not-found-search");
        var root = input?.closest("[data-nf-search]");
        var menu = root?.querySelector(".nf-search-menu");
        var links = menu ? [...menu.querySelectorAll("a")] : [];
        if (!input || !menu) return;

        function update() {
            var term = input.value.trim().toLowerCase();
            var visible = 0;
            links.forEach(function (link) {
                var match = !term || link.textContent.toLowerCase().includes(term);
                link.style.display = match ? "" : "none";
                if (match) visible++;
            });
            menu.classList.toggle("is-open", document.activeElement === input && visible > 0);
        }

        input.addEventListener("focus", update);
        input.addEventListener("input", update);
        input.addEventListener("blur", function () {
            setTimeout(function () { menu.classList.remove("is-open"); }, 150);
        });
        input.addEventListener("keydown", function (e) {
            if (e.key !== "Enter") return;
            var value = input.value.trim();
            var shown = links.filter(function (l) { return l.style.display !== "none"; });
            if (shown.length === 1) {
                location.href = shown[0].getAttribute("href");
            } else if (value.charAt(0) === "/") {
                location.href = value;
            } else if (value) {
                location.href = "/models";
            }
        });

        menu.addEventListener("mousedown", function (e) {
            var link = e.target.closest("a[href]");
            if (!link) return;
            e.preventDefault();
            location.href = link.getAttribute("href");
        });
    })();
</script>

<style is:global>
    .not-found-main {
        padding: 22px 0 64px;
    }

    .not-found-hero {
        display: grid;
        gap: 16px;
        padding: clamp(28px, 4.6vw, 52px);
    }

    .not-found-hero h1 {
        margin: 0;
        font-size: clamp(2.35rem, 4.7vw, 3.6rem);
        line-height: 1.04;
        letter-spacing: -0.045em;
    }

    .not-found-lede {
        margin: 0;
        max-width: 56ch;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.55;
    }

    .not-found-search {
        position: relative;
        max-width: 420px;
        margin-top: 4px;
    }

    .not-found-search .search-field {
        width: 100%;
    }

    .nf-search-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        z-index: 10;
        display: none;
        max-height: 260px;
        overflow-y: auto;
        padding: 6px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-raised-shadow);
    }

    .nf-search-menu.is-open {
        display: block;
    }

    .nf-search-menu a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        color: var(--text);
        font-size: 0.92rem;
        text-decoration: none;
        transition: background 120ms var(--ease-out-smooth), color 120ms var(--ease-out-smooth);
    }

    .nf-search-menu a .material-symbols-outlined {
        color: var(--dim);
        font-size: 1.1rem;
        transition: color 120ms var(--ease-out-smooth);
    }

    .nf-search-menu a:hover,
    .nf-search-menu a:focus {
        background: var(--accent-muted);
        color: var(--accent-text);
        outline: 0;
    }

    .nf-search-menu a:hover .material-symbols-outlined,
    .nf-search-menu a:focus .material-symbols-outlined {
        color: var(--accent);
    }

    .not-found-links {
        display: grid;
        gap: 18px;
        padding: clamp(22px, 3.8vw, 36px);
    }

    .not-found-links .eyebrow {
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .not-found-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
    }

    .not-found-tile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        color: var(--text);
        text-decoration: none;
        transition: border-color 150ms var(--ease-out-smooth), transform 100ms var(--ease-out-smooth);
    }

    .not-found-tile .material-symbols-outlined {
        color: var(--accent);
        font-size: 1.25rem;
    }

    .not-found-tile strong {
        font-weight: 500;
        font-size: 0.98rem;
    }

    .not-found-tile:hover {
        border-color: oklch(0.659 0.192 40.1 / 0.42);
        transform: translateY(-1px);
    }

    .not-found-tile:active {
        transform: scale(var(--press-scale));
    }

    @media (prefers-reduced-motion: reduce) {
        .not-found-tile,
        .not-found-tile:hover,
        .not-found-tile:active,
        .nf-search-menu a {
            transition: none;
            transform: none;
        }
    }
</style>
