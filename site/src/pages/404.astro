---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { buildDefaultPageJsonLd } from "../utils/jsonLd";

const jsonLd = buildDefaultPageJsonLd();
---

<Layout
    title="Page not found - FreeTheAi"
    description={siteConfig.description}
    jsonLd={jsonLd}
    currentPath="/404"
>
    <main class="not-found-main">
        <section class="not-found-card shell">
            <div class="nf-glow" aria-hidden="true"></div>
            <div class="nf-code" aria-hidden="true">404</div>
            <span class="eyebrow nf-eyebrow">
                <span class="material-symbols-outlined" aria-hidden="true">error</span>
                resource_not_found
            </span>
            <h1>Lost in the model catalog.</h1>
            <p>
                The page you tried to open doesn't exist. The free OpenAI-compatible
                API and the full site are still right here.
            </p>
            <div class="nf-search">
                <span class="material-symbols-outlined nf-search-icon" aria-hidden="true">search</span>
                <label class="sr-only" for="not-found-search">Search the site</label>
                <input
                    type="search"
                    id="not-found-search"
                    list="site-pages"
                    placeholder="Search pages..."
                    aria-label="Search pages"
                />
                <datalist id="site-pages">
                    <option value="/home">Home</option>
                    <option value="/docs">API docs</option>
                    <option value="/models">Model catalog</option>
                    <option value="/pricing">Pricing</option>
                    <option value="/status">Status</option>
                    <option value="/quickstart">Quickstart</option>
                    <option value="/setup">Setup guides</option>
                    <option value="/roleplay-api">Roleplay API</option>
                    <option value="/coding-agent-api">Coding agent API</option>
                    <option value="/openai-compatible-api">OpenAI-compatible API</option>
                </datalist>
            </div>
            <div class="nf-links">
                <a class="primary-button nf-home" href="/home">
                    <span class="material-symbols-outlined" aria-hidden="true">home</span>
                    <span>Back to home</span>
                </a>
                <a class="nf-tile" href="/quickstart">
                    <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
                    <span>Quickstart</span>
                </a>
                <a class="nf-tile" href="/models">
                    <span class="material-symbols-outlined" aria-hidden="true">view_carousel</span>
                    <span>Models</span>
                </a>
                <a class="nf-tile" href="/docs">
                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                    <span>Docs</span>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script>
	(function poll(attempts) {
		if (typeof window.__soundPlay === 'function') {
			window.__soundPlay('notification.error');
		} else if (attempts > 0) {
			setTimeout(function () { poll(attempts - 1); }, 100);
		}
	})(50);

	(function () {
		var input = document.getElementById('not-found-search');
		if (!input) return;
		input.addEventListener('keydown', function (e) {
			if (e.key !== 'Enter') return;
			var value = input.value.trim();
			if (value.charAt(0) === '/') {
				location.href = value;
			} else if (value) {
				location.href = '/models';
			}
		});
	})();
</script>

<style is:global>
    .not-found-main {
        display: grid;
        place-items: center;
        min-height: 65vh;
        padding: 32px 0;
    }

    .not-found-card {
        position: relative;
        display: grid;
        gap: 14px;
        max-width: 600px;
        padding: clamp(28px, 4.6vw, 44px);
        text-align: center;
        overflow: hidden;
    }

    /* Animated glow behind 404 */
    .nf-glow {
        position: absolute;
        top: -30%;
        left: 50%;
        width: 340px;
        height: 340px;
        translate: -50% 0;
        border-radius: 50%;
        background: radial-gradient(circle, oklch(0.659 0.192 40.1 / 0.18) 0%, transparent 65%);
        filter: blur(40px);
        animation: nf-pulse 4s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes nf-pulse {
        0%, 100% { opacity: 0.5; scale: 1; }
        50% { opacity: 0.9; scale: 1.08; }
    }

    /* Large stylized 404 */
    .nf-code {
        font-family: var(--font-mono);
        font-size: clamp(5rem, 16vw, 9rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--accent);
        text-shadow: 0 0 30px oklch(0.659 0.192 40.1 / 0.4), 0 0 60px oklch(0.659 0.192 40.1 / 0.15);
        user-select: none;
    }

    .nf-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        justify-self: center;
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 0.72rem;
    }

    .nf-eyebrow .material-symbols-outlined {
        font-size: 0.95rem;
        color: var(--accent);
    }

    .not-found-card h1 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .not-found-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    /* Search with icon */
    .nf-search {
        position: relative;
        margin-top: 4px;
    }

    .nf-search-icon {
        position: absolute;
        top: 50%;
        left: 14px;
        translate: 0 -50%;
        font-size: 1.15rem;
        color: var(--dim);
        pointer-events: none;
    }

    .nf-search input {
        width: 100%;
        padding: 12px 16px 12px 42px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius-full);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-inset-shadow);
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 0.88rem;
        outline: none;
        transition: border-color 200ms var(--ease-out-smooth), box-shadow 200ms var(--ease-out-smooth);
    }

    .nf-search input::placeholder {
        color: var(--dim);
    }

    .nf-search input:focus {
        border-color: oklch(0.659 0.192 40.1 / 0.5);
        box-shadow: var(--sk-inset-shadow), 0 0 0 3px oklch(0.659 0.192 40.1 / 0.12);
    }

    /* Link tiles */
    .nf-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 6px;
    }

    .nf-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .nf-home .material-symbols-outlined {
        font-size: 1.1rem;
    }

    .nf-tile {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-inset-shadow);
        color: var(--muted);
        font-size: 0.88rem;
        text-decoration: none;
        transition: color 150ms var(--ease-out-smooth), border-color 150ms var(--ease-out-smooth), transform 100ms var(--ease-out-smooth);
    }

    .nf-tile .material-symbols-outlined {
        font-size: 1.05rem;
        color: var(--dim);
        transition: color 150ms var(--ease-out-smooth);
    }

    .nf-tile:hover {
        color: var(--accent-text);
        border-color: oklch(0.659 0.192 40.1 / 0.42);
        transform: translateY(-1px);
    }

    .nf-tile:hover .material-symbols-outlined {
        color: var(--accent);
    }

    .nf-tile:active {
        transform: scale(var(--press-scale));
    }

    @media (prefers-reduced-motion: reduce) {
        .nf-glow { animation: none; }
        .nf-tile, .nf-search input { transition: none; }
        .nf-tile:hover { transform: none; }
    }
</style>
