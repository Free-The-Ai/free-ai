---
import Layout from "../layouts/Layout.astro";
import DocsAccordion from "../components/DocsAccordion";
import DocsMobileNav from "../components/DocsMobileNav";
import {
    buildOrganizationJsonLd,
    buildSoftwareJsonLd,
    buildWebsiteJsonLd,
    buildWebApiJsonLd,
    buildMachineReadableResourcesJsonLd,
    buildSignupHowToJsonLd,
    buildBreadcrumbJsonLd,
} from "../utils/jsonLd";
import { highlight } from "../lib/highlight";

const pageDescription =
    "FreeTheAi API docs for OpenAI-compatible chat completions, Anthropic-style messages, image generation, image edits, audio, model listing, signup, check-in, and key reset.";

const jsonLd = [
    buildWebsiteJsonLd(),
    buildOrganizationJsonLd(),
    buildSoftwareJsonLd(),
    buildWebApiJsonLd(),
    buildMachineReadableResourcesJsonLd(),
    buildSignupHowToJsonLd(),
    buildBreadcrumbJsonLd([
        { name: "FreeTheAi", url: "https://freetheai.xyz/home" },
        { name: "API Docs", url: "https://freetheai.xyz/docs" },
    ]),
];

const baseSnippet = `Base URL
https://api.freetheai.xyz/v1

Header
Authorization: Bearer YOUR_API_KEY`;
const baseSnippetHtml = await highlight(baseSnippet, "bash");

const chatCurlSnippet = `curl https://api.freetheai.xyz/v1/chat/completions \\
  -H "Authorization: Bearer $FREETHEAI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "opc/deepseek-v4-flash-free",
    "messages": [
      { "role": "user", "content": "Write a tiny Flask route." }
    ],
    "stream": true
  }'`;
const chatCurlSnippetHtml = await highlight(chatCurlSnippet, "bash");

const openAISDKSnippet = `import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.FREETHEAI_API_KEY,
  baseURL: "https://api.freetheai.xyz/v1"
});

const res = await client.chat.completions.create({
  model: "opc/deepseek-v4-flash-free",
  messages: [{ role: "user", content: "Reply with OK." }]
});

console.log(res.choices[0].message.content);`;
const openAISDKSnippetHtml = await highlight(openAISDKSnippet, "javascript");

const messagesSnippet = `curl https://api.freetheai.xyz/v1/messages \\
  -H "Authorization: Bearer $FREETHEAI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "opc/deepseek-v4-flash-free",
    "max_tokens": 256,
    "messages": [
      { "role": "user", "content": "Give me a short implementation plan." }
    ]
  }'`;
const messagesSnippetHtml = await highlight(messagesSnippet, "bash");

const modelListSnippet = `curl https://api.freetheai.xyz/v1/models \\
  -H "Authorization: Bearer $FREETHEAI_API_KEY"`;
const modelListSnippetHtml = await highlight(modelListSnippet, "bash");

const fullModelListSnippet = `curl "https://api.freetheai.xyz/v1/models/full" \\
  -H "Authorization: Bearer freetheai.xyz"`;
const fullModelListSnippetHtml = await highlight(fullModelListSnippet, "bash");

const endpoints = [
    {
        method: "POST",
        path: "/v1/chat/completions",
        desc: "OpenAI-compatible chat, streaming, tool calling, and multi-turn conversations.",
        anchor: "chat",
    },
    {
        method: "POST",
        path: "/v1/messages",
        desc: "Anthropic-compatible Messages route for Claude-style clients.",
        anchor: "messages",
    },
    {
        method: "POST",
        path: "/v1/responses",
        desc: "Responses-style route. Same key, same model alias.",
        anchor: "compatibility",
    },
    {
        method: "POST",
        path: "/v1/images/generations",
        desc: "OpenAI-compatible image generation for supported image aliases.",
        anchor: "compatibility",
    },
    {
        method: "POST",
        path: "/v1/images/edits",
        desc: "OpenAI-compatible multipart image edits for supported image aliases.",
        anchor: "compatibility",
    },
    {
        method: "GET",
        path: "/v1/images/generations/{request_id}",
        desc: "Poll async EVE image generation jobs.",
        anchor: "compatibility",
    },
    {
        method: "GET",
        path: "/v1/models",
        desc: "Authenticated model list for normal clients.",
        anchor: "models",
    },
    {
        method: "GET",
        path: "/v1/models/full",
        desc: "Expanded catalog with context, output, and access metadata.",
        anchor: "models",
    },
    {
        method: "GET",
        path: "/v1/models/leaderboard",
        desc: "Site-key model leaderboard for public widgets.",
        anchor: "models",
    },
    {
        method: "POST",
        path: "/v1/audio/speech",
        desc: "Text-to-speech for supported voice aliases.",
        anchor: "compatibility",
    },
    {
        method: "POST",
        path: "/v1/audio/transcriptions",
        desc: "Speech-to-text multipart uploads for supported voice aliases.",
        anchor: "compatibility",
    },
    {
        method: "GET",
        path: "/v1/health",
        desc: "Public API health and catalog status.",
        anchor: "endpoints",
    },
];
---

<Layout
    title="FreeTheAi API Docs - OpenAI-Compatible Chat and Models"
    description={pageDescription}
    jsonLd={jsonLd}
    currentPath="/docs"
>
    <main class="docs-main" data-docs-nav>
        <DocsMobileNav client:load />
        <section class="docs-layout">
            <aside
                class="docs-sidebar"
                id="docs-section-nav"
                aria-label="Docs sections"
            >
                <span class="docs-sidebar-label">On this page</span>
                <a href="#auth">Auth</a>
                <a href="#endpoints">Endpoints</a>
                <a href="#compatibility">Compatibility</a>
                <a href="#chat">Chat</a>
                <a href="#messages">Messages</a>
                <a href="#models">Models</a>
                <a href="#errors">Errors</a>
            </aside>

            <div class="docs-content">
                <section class="docs-hero shell">
                    <span class="eyebrow">API Docs</span>
                    <h1>One key, one base URL.</h1>
                    <p class="docs-lede">
                        OpenAI-compatible chat, Anthropic-style messages, image
                        generation, audio, and the full model catalog. Same key,
                        same base URL.
                    </p>
                    <div class="docs-hero-meta">
                        <span class="docs-hero-stat">
                            <strong>{endpoints.length}</strong> endpoints
                        </span>
                        <span class="docs-hero-stat">
                            <strong>3</strong> formats
                        </span>
                        <span class="docs-hero-stat">
                            <strong>0¢</strong> free tier
                        </span>
                    </div>
                </section>

                <section class="docs-section shell" id="getting-started">
                    <header class="section-head">
                        <span class="eyebrow">Getting started</span>
                        <h2>Connect in seconds.</h2>
                    </header>
                    <div class="docs-start-card">
                        <div class="docs-start-row">
                            <div class="docs-start-info">
                                <span class="docs-start-label">Base URL</span>
                                <code>https://api.freetheai.xyz/v1</code>
                            </div>
                            <button class="docs-start-copy" type="button" data-copy="https://api.freetheai.xyz/v1" aria-label="Copy base URL">
                                <span class="material-symbols-outlined">content_copy</span>
                            </button>
                        </div>
                        <div class="docs-start-row">
                            <div class="docs-start-info">
                                <span class="docs-start-label">Auth header</span>
                                <code>Authorization: Bearer YOUR_API_KEY</code>
                            </div>
                            <button class="docs-start-copy" type="button" data-copy="Authorization: Bearer YOUR_API_KEY" aria-label="Copy auth header">
                                <span class="material-symbols-outlined">content_copy</span>
                            </button>
                        </div>
                    </div>
                    <script is:inline>
                        (function () {
                            document.querySelectorAll('.docs-start-copy').forEach(function (btn) {
                                btn.addEventListener('click', function () {
                                    const text = btn.getAttribute('data-copy') || '';
                                    navigator.clipboard.writeText(text).catch(function () {});
                                    const icon = btn.querySelector('.material-symbols-outlined');
                                    if (!icon) return;
                                    icon.textContent = 'check';
                                    setTimeout(function () { icon.textContent = 'content_copy'; }, 1200);
                                });
                            });
                        })();
                    </script>
                </section>

                <section class="docs-section shell" id="endpoints">
                    <header class="section-head">
                        <span class="eyebrow">Endpoints</span>
                        <h2>Every route.</h2>
                    </header>
                    <div class="search-field docs-endpoint-search">
                        <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        <input
                            type="search"
                            placeholder="Filter endpoints..."
                            data-filter-target=".docs-endpoint-card"
                        />
                    </div>
                    <div class="docs-endpoint-grid">
                        {endpoints.map(({ method, path, desc, anchor }) => (
                            <a class="docs-endpoint-card" href={`#${anchor}`}>
                                <span class={`docs-method docs-method-${method.toLowerCase()}`}>{method}</span>
                                <code class="docs-path">{path}</code>
                                <span class="docs-endpoint-desc">{desc}</span>
                            </a>
                        ))}
                    </div>
                    <script is:inline>
                        (function () {
                            const input = document.querySelector('[data-filter-target=".docs-endpoint-card"]');
                            if (!input) return;
                            const cards = [...document.querySelectorAll('.docs-endpoint-card')];
                            input.addEventListener('input', function () {
                                const term = input.value.trim().toLowerCase();
                                cards.forEach(function (card) {
                                    const match = !term || card.textContent.toLowerCase().includes(term);
                                    card.style.display = match ? '' : 'none';
                                });
                            });
                        })();
                    </script>
                </section>

                <section class="docs-section shell" id="details">
                    <DocsAccordion
                        baseSnippet={baseSnippet}
                        chatCurlSnippet={chatCurlSnippet}
                        chatCurlSnippetHtml={chatCurlSnippetHtml}
                        openAISDKSnippet={openAISDKSnippet}
                        openAISDKSnippetHtml={openAISDKSnippetHtml}
                        messagesSnippet={messagesSnippet}
                        messagesSnippetHtml={messagesSnippetHtml}
                        modelListSnippet={modelListSnippet}
                        modelListSnippetHtml={modelListSnippetHtml}
                        fullModelListSnippet={fullModelListSnippet}
                        fullModelListSnippetHtml={fullModelListSnippetHtml}
                        endpoints={endpoints.map((e) => [e.method, e.path, e.desc])}
                    />
                </section>
            </div>
        </section>
    </main>
</Layout>

<style is:global>
    .docs-hero {
        display: grid;
        gap: 12px;
        padding: clamp(28px, 4.6vw, 52px);
        text-align: center;
        justify-items: center;
    }

    .docs-hero .eyebrow {
        color: var(--dim);
    }

    .docs-hero h1 {
        margin: 0;
        font-size: clamp(2.35rem, 4.7vw, 3.6rem);
        line-height: 1.04;
        letter-spacing: -0.045em;
        text-wrap: balance;
    }

    .docs-lede {
        margin: 0;
        max-width: 62ch;
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.6;
        text-wrap: pretty;
    }

    .docs-hero-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-top: 4px;
    }

    .docs-hero-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-inset-shadow);
        color: var(--muted);
        font-size: 0.9rem;
    }

    .docs-hero-stat strong {
        color: var(--accent-text);
        font-family: var(--font-serif);
        font-size: 1.2rem;
        text-shadow: var(--accent-text-glow);
    }

    .docs-start-card {
        display: grid;
        gap: 12px;
        padding: 18px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-shell-bg);
        box-shadow: var(--sk-raised-shadow);
    }

    .docs-start-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border: 1px solid var(--sk-border);
        border-radius: calc(var(--radius) - 4px);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-inset-shadow);
    }

    .docs-start-info {
        display: grid;
        gap: 6px;
        min-width: 0;
    }

    .docs-start-label {
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .docs-start-info code {
        color: var(--accent-text);
        font-family: var(--font-mono);
        font-size: 0.92rem;
        text-shadow: var(--accent-text-glow);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .docs-start-copy {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid var(--sk-border);
        border-radius: calc(var(--radius) - 8px);
        background: var(--sk-shell-bg);
        color: var(--muted);
        cursor: pointer;
        transition: transform 140ms var(--ease-out-smooth), border-color 140ms var(--ease-out-smooth), color 140ms var(--ease-out-smooth);
    }

    .docs-start-copy:hover {
        color: var(--text);
        border-color: oklch(0.659 0.192 40.1 / 0.42);
    }

    .docs-start-copy:active {
        transform: scale(0.96);
    }

    .docs-endpoint-search {
        max-width: 420px;
        margin-bottom: 4px;
    }

    .docs-endpoint-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
    }

    .docs-endpoint-card {
        display: grid;
        gap: 8px;
        padding: 16px 18px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-inset-bg);
        box-shadow: var(--sk-inset-shadow);
        color: var(--text);
        text-decoration: none;
        transition: border-color 150ms var(--ease-out-smooth), transform 150ms var(--ease-out-smooth);
    }

    .docs-endpoint-card:hover {
        border-color: oklch(0.659 0.192 40.1 / 0.42);
        transform: translateY(-1px);
    }

    .docs-endpoint-card:active {
        transform: scale(0.98);
    }

    .docs-method {
        justify-self: start;
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .docs-method-get { background: oklch(0.72 0.15 145 / 0.15); color: oklch(0.72 0.15 145); }
    .docs-method-post { background: oklch(0.659 0.192 40.1 / 0.15); color: var(--accent-text); }

    .docs-path {
        font-family: var(--font-mono);
        font-size: 0.88rem;
        color: var(--text);
    }

    .docs-endpoint-desc {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.5;
    }

    @media (max-width: 760px) {
        .docs-start-row {
            border-radius: calc(var(--radius) - 2px);
        }

        .docs-start-copy {
            border-radius: calc(var(--radius) - 6px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .docs-endpoint-card,
        .docs-endpoint-card:hover,
        .docs-endpoint-card:active,
        .docs-start-copy,
        .docs-start-copy:active {
            transition: none;
            transform: none;
        }
    }
</style>
