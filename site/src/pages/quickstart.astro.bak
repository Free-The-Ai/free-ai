---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { highlight } from "../lib/highlight";
import {
    buildWebsiteJsonLd,
    buildOrganizationJsonLd,
    buildSoftwareJsonLd,
    buildWebApiJsonLd,
    buildSignupHowToJsonLd,
    buildBreadcrumbJsonLd,
} from "../utils/jsonLd";

const pageDescription =
    "FreeTheAi quickstart: get a free API key from Discord, unlock it for the day with /checkin, then point the OpenAI Python or JavaScript SDK at https://api.freetheai.xyz/v1 and ship your first chat completion in minutes.";

const quickstartHowToJsonLd = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Send your first FreeTheAi chat completion",
    description:
        "Get a key in Discord, unlock it daily with /checkin, install the OpenAI SDK, point base_url at FreeTheAi, and send a chat completion.",
    totalTime: "PT5M",
    supply: [
        {
            "@type": "HowToSupply",
            name: "FreeTheAi API key from Discord /signup",
        },
    ],
    tool: [
        {
            "@type": "HowToTool",
            name: "OpenAI Python SDK",
        },
        {
            "@type": "HowToTool",
            name: "OpenAI Node.js SDK",
        },
    ],
    step: [
        {
            "@type": "HowToStep",
            name: "Get a free key",
            text: "Join discord.gg/secrets, run /signup, and complete the human challenge to receive a FreeTheAi API key.",
            url: "https://freetheai.xyz/quickstart#step-key",
        },
        {
            "@type": "HowToStep",
            name: "Unlock today with /checkin",
            text: "Run /checkin in Discord once per UTC day and solve the lightweight human challenge so the API stops returning daily_checkin_required.",
            url: "https://freetheai.xyz/quickstart#step-checkin",
        },
        {
            "@type": "HowToStep",
            name: "Install the SDK",
            text: "Install the OpenAI SDK with pip install openai or npm install openai.",
            url: "https://freetheai.xyz/quickstart#step-install",
        },
        {
            "@type": "HowToStep",
            name: "Point base URL at FreeTheAi",
            text: "Configure the OpenAI client with base_url https://api.freetheai.xyz/v1 and your FreeTheAi API key.",
            url: "https://freetheai.xyz/quickstart#step-baseurl",
        },
        {
            "@type": "HowToStep",
            name: "Send your first request",
            text: "Call chat.completions.create with any model alias from the FreeTheAi catalog and read the assistant reply.",
            url: "https://freetheai.xyz/quickstart#step-request",
        },
    ],
};

const jsonLd = [
    buildWebsiteJsonLd(),
    buildOrganizationJsonLd(),
    buildSoftwareJsonLd(),
    buildWebApiJsonLd(),
    buildSignupHowToJsonLd(),
    quickstartHowToJsonLd,
    buildBreadcrumbJsonLd([
        { name: "FreeTheAi", url: "https://freetheai.xyz/home" },
        { name: "Quickstart", url: "https://freetheai.xyz/quickstart" },
    ]),
];

const pythonSnippet = `from openai import OpenAI

client = OpenAI(
    api_key=os.environ["FREETHEAI_API_KEY"],
    base_url="https://api.freetheai.xyz/v1",
)

response = client.chat.completions.create(
    model="opc/deepseek-v4-flash-free",
    messages=[{"role": "user", "content": "Reply with OK."}],
)

print(response.choices[0].message.content)
`;

const jsSnippet = `import OpenAI from "openai";

const client = new OpenAI({
    apiKey: process.env.FREETHEAI_API_KEY,
    baseURL: "https://api.freetheai.xyz/v1",
});

const response = await client.chat.completions.create({
    model: "opc/deepseek-v4-flash-free",
    messages: [{ role: "user", content: "Reply with OK." }],
});

console.log(response.choices[0].message.content);
`;

const curlSnippet = `curl https://api.freetheai.xyz/v1/chat/completions \\
  -H "Authorization: Bearer $FREETHEAI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "opc/deepseek-v4-flash-free",
    "messages": [{"role": "user", "content": "Reply with OK."}]
  }'
`;

const highlightedPython = await highlight(pythonSnippet, "python");
const highlightedJs = await highlight(jsSnippet, "typescript");
const highlightedCurl = await highlight(curlSnippet, "bash");

const installCommands = {
    python: "pip install openai",
    node: "npm install openai",
};
const highlightedInstallPython = await highlight(installCommands.python, "bash");
const highlightedInstallJs = await highlight(installCommands.node, "bash");
---

<Layout
    title="FreeTheAi Quickstart - Free OpenAI-Compatible API in Minutes"
    description={pageDescription}
    jsonLd={jsonLd}
    currentPath="/quickstart"
>
    <main class="quickstart-main">
        <section class="quickstart-hero shell">
            <span class="eyebrow">Quickstart</span>
            <h1>Free AI API, ready in minutes.</h1>
            <p class="quickstart-lede">
                Sign up in Discord, unlock your key with <code>/checkin</code>,
                point the OpenAI SDK at FreeTheAi, send a chat completion. No
                credit card. No waiting list.
            </p>
            <div class="quickstart-cta-row">
                <a class="primary-button" href={siteConfig.socials.discord} target="_blank" rel="noreferrer">
                    <span>Get a free key</span>
                    <span class="cta-arrow" aria-hidden="true">&rarr;</span>
                </a>
                <a class="quickstart-secondary" href="/models">
                    Browse 80+ active models
                </a>
            </div>
        </section>

        <section class="quickstart-base shell">
            <div class="quickstart-base-card">
                <div class="quickstart-base-item">
                    <span>Base URL</span>
                    <code>https://api.freetheai.xyz/v1</code>
                </div>
                <div class="quickstart-base-item">
                    <span>Auth header</span>
                    <code>Authorization: Bearer YOUR_API_KEY</code>
                </div>
            </div>
        </section>

        <ol class="quickstart-timeline">
            <li class="quickstart-step shell" id="step-key">
                <span class="quickstart-step-num">1</span>
                <div class="quickstart-step-body">
                    <h2>Get a free API key</h2>
                    <p>
                        Join the FreeTheAi Discord, run <code>/signup</code>, and
                        complete the modal. You get an active key immediately.
                    </p>
                    <ul class="quickstart-list">
                        <li>Join <a href={siteConfig.socials.discord} target="_blank" rel="noreferrer">discord.gg/secrets</a></li>
                        <li>Run <code>/signup</code> and answer the use-case + bot-disclosure + human challenge</li>
                        <li>Lost your key later? Use <code>/resetkey</code> to rotate it</li>
                    </ul>
                </div>
            </li>

            <li class="quickstart-step shell" id="step-checkin">
                <span class="quickstart-step-num">2</span>
                <div class="quickstart-step-body">
                    <h2>Unlock today with /checkin</h2>
                    <p>
                        FreeTheAi uses a daily <code>/checkin</code> in Discord to
                        keep automated bots and abuse off the free pool. Run it once
                        per UTC day with your existing key, solve a tiny human
                        challenge, and your key is unlocked for the next 24 hours.
                    </p>
                    <ul class="quickstart-list">
                        <li>Run <code>/checkin</code> in Discord and paste your existing API key</li>
                        <li>Solve the randomized challenge — it's a lighter captcha</li>
                        <li>Until you check in, requests return <code>403 daily_checkin_required</code></li>
                    </ul>
                </div>
            </li>

            <li class="quickstart-step shell" id="step-install">
                <span class="quickstart-step-num">3</span>
                <div class="quickstart-step-body">
                    <h2>Install the OpenAI SDK</h2>
                    <p>
                        FreeTheAi is OpenAI-compatible, so you can keep using the
                        official SDK you already have.
                    </p>
                    <div class="quickstart-tabs" data-tabs>
                        <div class="quickstart-tab-list" role="tablist">
                            <button type="button" class="quickstart-tab is-active" role="tab" data-tab="install-python" aria-selected="true">Python</button>
                            <button type="button" class="quickstart-tab" role="tab" data-tab="install-node">Node.js</button>
                        </div>
                        <div class="quickstart-tab-panel is-active" role="tabpanel" data-tab-panel="install-python">
                            <div class="quickstart-snippet">
                                <button class="copy-btn" type="button" aria-label="Copy Python install command">
                                    <span class="material-symbols-outlined">content_copy</span>
                                </button>
                                <pre set:html={highlightedInstallPython} />
                            </div>
                        </div>
                        <div class="quickstart-tab-panel" role="tabpanel" data-tab-panel="install-node">
                            <div class="quickstart-snippet">
                                <button class="copy-btn" type="button" aria-label="Copy Node.js install command">
                                    <span class="material-symbols-outlined">content_copy</span>
                                </button>
                                <pre set:html={highlightedInstallJs} />
                            </div>
                        </div>
                    </div>
                </div>
            </li>

            <li class="quickstart-step shell" id="step-baseurl">
                <span class="quickstart-step-num">4</span>
                <div class="quickstart-step-body">
                    <h2>Point base URL at FreeTheAi</h2>
                    <p>
                        Set <code>base_url</code> (or <code>baseURL</code>) to{" "}
                        <code>https://api.freetheai.xyz/v1</code> and pass your
                        FreeTheAi key as the API key.
                    </p>
                    <div class="quickstart-snippet">
                        <button class="copy-btn" type="button" aria-label="Copy base URL">
                            <span class="material-symbols-outlined">content_copy</span>
                        </button>
                        <pre><code>https://api.freetheai.xyz/v1</code></pre>
                    </div>
                </div>
            </li>

            <li class="quickstart-step shell" id="step-request">
                <span class="quickstart-step-num">5</span>
                <div class="quickstart-step-body">
                    <h2>Send your first request</h2>
                    <p>
                        Pick any alias from the model catalog. Pricing on the free
                        tier stays $0.
                    </p>
                    <div class="quickstart-tabs" data-tabs>
                        <div class="quickstart-tab-list" role="tablist">
                            <button type="button" class="quickstart-tab is-active" role="tab" data-tab="request-python" aria-selected="true">Python</button>
                            <button type="button" class="quickstart-tab" role="tab" data-tab="request-node">Node.js</button>
                            <button type="button" class="quickstart-tab" role="tab" data-tab="request-curl">curl</button>
                        </div>
                        <div class="quickstart-tab-panel is-active" role="tabpanel" data-tab-panel="request-python">
                            <div class="quickstart-snippet">
                                <button class="copy-btn" type="button" aria-label="Copy Python example">
                                    <span class="material-symbols-outlined">content_copy</span>
                                </button>
                                <pre set:html={highlightedPython} />
                            </div>
                        </div>
                        <div class="quickstart-tab-panel" role="tabpanel" data-tab-panel="request-node">
                            <div class="quickstart-snippet">
                                <button class="copy-btn" type="button" aria-label="Copy JavaScript example">
                                    <span class="material-symbols-outlined">content_copy</span>
                                </button>
                                <pre set:html={highlightedJs} />
                            </div>
                        </div>
                        <div class="quickstart-tab-panel" role="tabpanel" data-tab-panel="request-curl">
                            <div class="quickstart-snippet">
                                <button class="copy-btn" type="button" aria-label="Copy curl example">
                                    <span class="material-symbols-outlined">content_copy</span>
                                </button>
                                <pre set:html={highlightedCurl} />
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        </ol>

        <section class="section shell quickstart-next">
            <header class="section-head">
                <span class="eyebrow">Next stops</span>
                <h2>Where to go next.</h2>
            </header>
            <div class="quickstart-link-grid">
                <a class="quickstart-link" href="/setup">
                    <strong>Setup guides</strong>
                    <span>OpenCode, Cline, Roo Code, Zed, SillyTavern, Janitor AI, Chub, and more.</span>
                </a>
                <a class="quickstart-link" href="/docs">
                    <strong>Full API docs</strong>
                    <span>Chat completions, Anthropic messages, models, images, errors, rate limits.</span>
                </a>
                <a class="quickstart-link" href="/models">
                    <strong>Model catalog</strong>
                    <span>Live searchable aliases with provider prefixes and copyable IDs.</span>
                </a>
                <a class="quickstart-link" href="/pricing">
                    <strong>Pricing</strong>
                    <span>The free tier stays free. Optional paid slots start at $8/month.</span>
                </a>
                <a class="quickstart-link" href="/status">
                    <strong>Status</strong>
                    <span>Live provider health by alias prefix.</span>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    (function () {
        document.querySelectorAll('[data-tabs]').forEach(function (tabs) {
            var tabList = tabs.querySelector('.quickstart-tab-list');
            var panels = [...tabs.querySelectorAll('[data-tab-panel]')];
            var tabButtons = [...tabList.querySelectorAll('[data-tab]')];
            if (!tabList || tabButtons.length === 0) return;

            tabList.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-tab]');
                if (!btn) return;
                var key = btn.getAttribute('data-tab');
                tabButtons.forEach(function (b) {
                    var active = b.getAttribute('data-tab') === key;
                    b.classList.toggle('is-active', active);
                    b.setAttribute('aria-selected', String(active));
                });
                panels.forEach(function (p) {
                    var active = p.getAttribute('data-tab-panel') === key;
                    p.classList.toggle('is-active', active);
                });
            });
        });
    })();
</script>

<style is:global>
    .quickstart-main {
        padding: 22px 0 64px;
    }

    .quickstart-hero {
        display: grid;
        gap: 16px;
        padding: clamp(28px, 4.6vw, 52px);
    }

    .quickstart-hero h1 {
        margin: 0;
        font-size: clamp(2.35rem, 4.7vw, 3.6rem);
        line-height: 1.04;
        letter-spacing: -0.045em;
    }

    .quickstart-lede {
        margin: 0;
        max-width: 56ch;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.55;
    }

    .quickstart-cta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin-top: 6px;
    }

    .quickstart-cta-row .cta-arrow {
        opacity: 0.65;
        font-size: 0.9rem;
    }

    .quickstart-secondary {
        color: var(--muted);
        font-size: 0.92rem;
        text-decoration: none;
        border-bottom: 1px solid var(--sk-border);
        padding-bottom: 2px;
        transition: color 150ms var(--ease-out-smooth), border-color 150ms var(--ease-out-smooth);
    }

    .quickstart-secondary:hover {
        color: var(--accent-text);
        border-color: oklch(0.659 0.192 40.1 / 0.42);
    }

    .quickstart-base {
        padding: 0 clamp(20px, 4vw, 40px) clamp(22px, 3.8vw, 36px);
    }

    .quickstart-base-card {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        padding: 18px 20px;
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-shell-bg);
        box-shadow: var(--sk-raised-shadow);
    }

    .quickstart-base-item {
        display: grid;
        gap: 6px;
    }

    .quickstart-base-item > span:first-child {
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .quickstart-base-item code {
        color: var(--accent-text);
        font-family: var(--font-mono);
        font-size: 0.92rem;
        text-shadow: var(--accent-text-glow);
    }

    .quickstart-timeline {
        display: grid;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .quickstart-step {
        position: relative;
        display: flex;
        gap: 18px;
        padding: clamp(22px, 3.8vw, 36px);
        padding-left: calc(24px + 36px + 18px);
    }

    .