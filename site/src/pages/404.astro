---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import { buildDefaultPageJsonLd } from "../utils/jsonLd";

const jsonLd = buildDefaultPageJsonLd();

const pages = [
    { href: "/home", label: "Home", icon: "home" },
    { href: "/docs", label: "API docs", icon: "menu_book" },
    { href: "/models", label: "Model catalog", icon: "view_carousel" },
    { href: "/quickstart", label: "Quickstart", icon: "rocket_launch" },
    { href: "/setup", label: "Setup guides", icon: "settings" },
    { href: "/pricing", label: "Pricing", icon: "payments" },
    { href: "/status", label: "Status", icon: "monitoring" },
    { href: "/support", label: "Support", icon: "support_agent" },
];
---

<Layout
    title="Page not found - FreeTheAi"
    description={siteConfig.description}
    jsonLd={jsonLd}
    currentPath="/404"
>
    <main class="not-found-main">
        <section class="not-found-card shell">
            <span class="not-found-watermark" aria-hidden="true">404</span>
            <span class="eyebrow">Error</span>
            <h1>Page not found.</h1>
            <p class="not-found-lede">
                The page you tried to open doesn't exist. The free OpenAI-compatible
                API and the full site are still right here.
            </p>

            <div class="not-found-search" data-nf-search>
                <div class="search-field">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <label class="sr-only" for="not-found-search">Find a page</label>
                    <input
                        type="search"
                        id="not-found-search"
                        placeholder="Find a page..."
                        aria-label="Find a page"
                        autocomplete="off"
                    />
                </div>
                <div class="nf-search-menu" role="listbox" aria-label="Site pages">
                    {pages.map((page) => (
                        <a role="option" href={page.href}>
                            <span>{page.label}</span>
                        </a>
                    ))}
                </div>
            </div>

            <a class="primary-button not-found-home" href="/home">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                <span>Back to home</span>
            </a>
        </section>
    </main>
</Layout>

<script>
    (function poll(attempts) {
        if (typeof window.__soundPlay === "function") {
            window.__soundPlay("notification.error");
        } else if (attempts > 0) {
            setTimeout(function () { poll(attempts - 1); }, 100);
        }
    })(50);

    (function () {
        var input = document.getElementById("not-found-search");
        var root = input?.closest("[data-nf-search]");
        var menu = root?.querySelector(".nf-search-menu");
        var links = menu ? [...menu.querySelectorAll("a")] : [];
        if (!input || !menu) return;

        function update(open) {
            var term = input.value.trim().toLowerCase();
            var visible = 0;
            links.forEach(function (link) {
                var match = !term || link.textContent.toLowerCase().includes(term);
                link.style.display = match ? "" : "none";
                if (match) visible++;
            });
            var shouldOpen = open !== false && document.activeElement === input && visible > 0;
            root.classList.toggle("has-menu", shouldOpen);
            menu.classList.toggle("is-open", shouldOpen);
        }

        input.addEventListener("focus", function () { update(true); });
        input.addEventListener("input", function () { update(true); });
        input.addEventListener("blur", function () {
            setTimeout(function () { update(false); }, 150);
        });
        input.addEventListener("keydown", function (e) {
            if (e.key !== "Enter") return;
            var value = input.value.trim();
            var shown = links.filter(function (l) { return l.style.display !== "none"; });
            if (shown.length === 1) {
                location.href = shown[0].getAttribute("href");
            } else if (value.charAt(0) === "/") {
                location.href = value;
            } else if (value) {
                location.href = "/models";
            }
        });

        menu.addEventListener("mousedown", function (e) {
            var link = e.target.closest("a[href]");
            if (!link) return;
            e.preventDefault();
            location.href = link.getAttribute("href");
        });
    })();
</script>

<style is:global>
    .not-found-main {
        display: grid;
        place-items: center;
        min-height: 65vh;
        padding: 32px 16px;
    }

    .not-found-card {
        position: relative;
        display: grid;
        gap: 18px;
        width: 100%;
        max-width: 520px;
        padding: clamp(36px, 6vw, 56px) clamp(28px, 5vw, 48px);
        border: 1px solid var(--sk-border);
        border-radius: var(--radius);
        background: var(--sk-shell-bg);
        box-shadow: var(--sk-raised-shadow);
        text-align: center;
        overflow: hidden;
    }

    .not-found-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        translate: -50% -50%;
        font-family: var(--font-mono);
        font-size: clamp(7rem, 22vw, 13rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--accent);
        opacity: 0.06;
        pointer-events: none;
        user-select: none;
    }

    .not-found-card .eyebrow {
        position: relative;
        z-index: 1;
        justify-self: center;
        color: var(--dim);
    }

    .not-found-card h1 {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 2.8rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .not-found-lede {
        position: relative;
        z-index: 1;
        margin: 0;
        color: var(--muted);
        font-size: 0.98rem;
        line-height: 1.55;
    }

    .not-found-search {
        position: relative;
        z-index: 1;
        text-align: left;
        margin-top: 2px;
    }

    .not-found-search .search-field {
        width: 100%;
    }

    .not-found-search.has-menu .search-field {
        border-radius: var(--radius) var(--radius) 0 0;
        border-bottom-color: transparent;
    }

    .nf-search-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 10;
        display: none;
        max-height: 240px;
        overflow-y: auto;
        padding: 4px 6px 6px;
        border: 1px solid var(--sk-border);
        border-top: 0;
        border-radius: 0 0 var(--radius) var(--radius);
        background: var(--sk-inset-bg);
        box-shadow: 0 10px 20px -8px oklch(0 0 0 / 0.45);
    }

    .nf-search-menu.is-open {
        display: block;
    }

    .nf-search-menu a {
        display: block;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--text);
        font-size: 0.92rem;
        text-decoration: none;
        transition: background 120ms var(--ease-out-smooth), color 120ms var(--ease-out-smooth);
    }

    .nf-search-menu a:hover,
    .nf-search-menu a:focus {
        background: var(--accent-muted);
        color: var(--accent-text);
        outline: 0;
    }

    .not-found-home {
        position: relative;
        z-index: 1;
        justify-self: center;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .not-found-home .material-symbols-outlined {
        font-size: 1.1rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .nf-search-menu a {
            transition: none;
        }
    }
</style>
